{
  "name": "smartpos-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "tsx watch index.ts",
    "start": "tsx index.ts",
    "migrate": "tsx migrate.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test tests/*.test.ts",
    "test:api": "vitest run tests/http.spec.ts",
    "test:db": "vitest run tests/postgres.integration.spec.ts"
  },
  "dependencies": {
    "express": "^5.1.0",
    "pg": "^8.13.0",
    "zod": "^3.24.0",
    "csv-parse": "^5.6.0",
    "bcryptjs": "^3.0.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/supertest": "^6.0.0",
    "supertest": "^7.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  }
}
